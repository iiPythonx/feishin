{
    "name": "feishin",
    "version": "26.5.18",
    "description": "A modern self-hosted music player.",
    "keywords": [
        "subsonic",
        "navidrome",
        "react",
        "electron"
    ],
    "homepage": "https://github.com/jeffvli/feishin",
    "bugs": {
        "url": "https://github.com/jeffvli/feishin/issues"
    },
    "license": "GPL-3.0",
    "author": {
        "name": "jeffvli",
        "email": "feishin@users.noreply.github.com",
        "url": "https://github.com/jeffvli/"
    },
    "main": "./out/main/index.js",
    "scripts": {
        "build": "pnpm run build:electron && pnpm run build:remote",
        "build:electron": "electron-vite build",
        "build:remote": "vite build --config remote.vite.config.ts",
        "build:web": "vite build --config web.vite.config.ts",
        "dev": "electron-vite dev",
        "dev:remote": "vite dev --config remote.vite.config.ts",
        "dev:watch": "electron-vite dev --watch",
        "i18next": "i18next -c src/i18n/i18next-parser.config.js",
        "postinstall": "install-electron && electron-builder install-app-deps",
        "lint": "pnpm run typecheck && pnpm run lint-code && pnpm run lint-styles",
        "lint:fix": "pnpm run lint-code:fix && pnpm run lint-styles:fix",
        "lint-code": "eslint --max-warnings=0 --cache .",
        "lint-code:fix": "eslint --cache --fix .",
        "lint-styles": "stylelint --max-warnings=0 'src/**/*.{css,scss}'",
        "lint-styles:fix": "stylelint 'src/**/*.{css,scss}' --fix",
        "package": "pnpm run build && electron-builder --linux --win",
        "package:dev": "pnpm run build && electron-builder --dir",
        "package:linux": "pnpm run build && electron-builder --linux",
        "package:linux-arm64": "pnpm run build && electron-builder --linux --arm64",
        "package:win": "pnpm run build && electron-builder --win",
        "package:win-arm64": "pnpm run build && electron-builder --win --arm64",
        "start": "electron-vite preview",
        "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
        "version": "pnpm version --no-git-tag-version"
    },
    "resolutions": {
        "react-router": "7.14.0",
        "xml2js": "0.5.0"
    },
    "dependencies": {
        "@atlaskit/pragmatic-drag-and-drop": "1.8.1",
        "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^2.1.5",
        "@atlaskit/pragmatic-drag-and-drop-hitbox": "^1.1.0",
        "@electron-toolkit/preload": "^3.0.2",
        "@electron-toolkit/utils": "^4.0.0",
        "@mantine/colors-generator": "^9.2.1",
        "@mantine/core": "^9.2.1",
        "@mantine/dates": "^9.2.1",
        "@mantine/form": "^9.2.1",
        "@mantine/hooks": "^9.2.1",
        "@mantine/modals": "^9.2.1",
        "@mantine/notifications": "^9.2.1",
        "@radix-ui/react-context-menu": "^2.2.16",
        "@tanstack/react-query": "^5.100.10",
        "@tanstack/react-query-devtools": "^5.100.10",
        "@tanstack/react-query-persist-client": "^5.100.10",
        "@ts-rest/core": "^3.52.1",
        "@wavesurfer/react": "^1.0.12",
        "@xhayper/discord-rpc": "^1.3.4",
        "audiomotion-analyzer": "^4.5.4",
        "axios": "^1.16.1",
        "butterchurn": "3.0.0-beta.5",
        "butterchurn-presets": "3.0.0-beta.4",
        "cheerio": "^1.2.0",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "dayjs": "^1.11.20",
        "dompurify": "^3.4.3",
        "electron-debug": "^3.2.0",
        "electron-localshortcut": "^3.2.1",
        "electron-log": "^5.4.4",
        "electron-store": "^8.2.0",
        "fast-average-color": "9.5.2",
        "fast-xml-parser": "^5.8.0",
        "format-duration": "^3.0.2",
        "fuse.js": "^7.3.0",
        "i18next": "^26.2.0",
        "icecast-metadata-stats": "^0.1.12",
        "idb-keyval": "^6.2.2",
        "immer": "^10.2.0",
        "is-electron": "^2.2.2",
        "lodash": "^4.18.1",
        "md5": "^2.3.0",
        "motion": "^12.38.0",
        "mpris-service": "^2.1.2",
        "nanoid": "^5.1.11",
        "overlayscrollbars": "^2.16.0",
        "overlayscrollbars-react": "^0.5.6",
        "qs": "^6.15.2",
        "react": "^19.2.6",
        "react-call": "^1.8.2",
        "react-dom": "^19.2.6",
        "react-error-boundary": "^5.0.0",
        "react-i18next": "^17.0.8",
        "react-icons": "^5.6.0",
        "react-player": "^2.16.1",
        "react-router": "7.15.1",
        "react-split-pane": "^3.2.0",
        "react-virtualized-auto-sizer": "^1.0.26",
        "react-window": "1.8.11",
        "react-window-v2": "npm:react-window@^2.2.7",
        "semver": "^7.8.0",
        "string-to-color": "^2.2.2",
        "wavesurfer.js": "^7.12.7",
        "ws": "^8.20.1",
        "zod": "^3.25.76",
        "zustand": "^5.0.13"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config-prettier": "^3.0.0",
        "@electron-toolkit/eslint-config-ts": "^3.1.0",
        "@electron-toolkit/tsconfig": "^2.0.0",
        "@types/electron-localshortcut": "^3.1.3",
        "@types/lodash": "^4.17.24",
        "@types/md5": "^2.3.6",
        "@types/node": "^24.12.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@types/react-window": "^1.8.8",
        "@types/source-map-support": "^0.5.10",
        "@types/ws": "^8.18.1",
        "@vitejs/plugin-react": "^5.2.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "concurrently": "^9.2.1",
        "cross-env": "^10.1.0",
        "electron": "^42.1.0",
        "electron-builder": "^26.10.0",
        "electron-devtools-installer": "^4.0.0",
        "electron-vite": "6.0.0-beta.1",
        "eslint": "^9.39.4",
        "eslint-plugin-perfectionist": "^4.15.1",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.4.26",
        "postcss-preset-mantine": "^1.18.0",
        "postcss-simple-vars": "^7.0.1",
        "prettier": "^3.8.3",
        "prettier-plugin-packagejson": "^2.5.22",
        "stylelint": "^17.11.1",
        "stylelint-config-css-modules": "^4.6.0",
        "stylelint-config-recess-order": "^7.7.0",
        "stylelint-config-standard": "^40.0.0",
        "typescript": "^5.9.3",
        "vite": "^8.0.13",
        "vite-plugin-conditional-import": "^0.1.7",
        "vite-plugin-dynamic-import": "^1.6.0",
        "vite-plugin-ejs": "^1.7.0",
        "vite-plugin-pwa": "^1.3.0"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "abstract-socket",
            "electron",
            "electron-winstaller",
            "esbuild"
        ]
    },
    "productName": "feishin"
}
